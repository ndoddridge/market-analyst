# Optional — falls back to Yahoo Finance (no key required) when unset.
FINNHUB_API_KEY=

# Directory where the persisted portfolio store JSON file is written.
# Local default is ./data (relative to the backend/ working directory).
# On Render this is set to the mounted persistent disk path (/var/data).
PORTFOLIO_DATA_DIR=./data

# Background dashboard refresh cadence, in milliseconds. Floored to 30000.
ANALYSIS_REFRESH_INTERVAL_MS=300000
